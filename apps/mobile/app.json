{
  "expo": {
    "name": "Edubite",
    "slug": "edubite-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "edubite",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.edubite.app",
      "infoPlist": {
        "CFBundleURLTypes": [
          {
            "CFBundleURLName": "edubite-auth",
            "CFBundleURLSchemes": [
              "edubite"
            ]
          }
        ]
      }
    },
    "android": {
      "package": "com.edubite.app",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "intentFilters": [
        {
          "action": "VIEW",
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ],
          "data": [
            {
              "scheme": "edubite",
              "host": "auth",
              "pathPrefix": "/callback"
            }
          ]
        }
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-web-browser",
      "expo-status-bar",
      "expo-dev-client",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.edubite-pending-ios-client"
        }
      ],
      "expo-asset"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "4e137e59-019f-4e7c-87e3-f1dac6295ee5"
      }
    },
    "owner": "edublast"
  }
}

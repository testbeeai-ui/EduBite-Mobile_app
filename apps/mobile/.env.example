# Copy to apps/mobile/.env and fill values from the shared Supabase project
# (same project as sibling Edubite — map NEXT_PUBLIC_* → EXPO_PUBLIC_*).
#
# NEVER put SUPABASE_SERVICE_ROLE_KEY or DB passwords here.
# Enable Anonymous sign-ins in Supabase Auth (silent session — no login UI).

EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Copy to apps/mobile/.env and fill values from the shared Supabase project
# (same project as sibling Edubite / web — map NEXT_PUBLIC_* → EXPO_PUBLIC_*).
#
# NEVER put SUPABASE_SERVICE_ROLE_KEY, Google Client Secret, or DB passwords here.
# Mobile may only use: project URL + anon/publishable key + public Google Web Client ID.
#
# Anonymous sign-ins are NOT used. App requires Google login at startup.
# Native builds use Google ID-token Sign-In; Expo Go uses browser PKCE OAuth.
#
# Master Google login switch. Restart Metro / rebuild APK after changing.
#   EXPO_PUBLIC_SKIP_AUTH=1  → login OFF (test Brain Gym / UI without Google)
#   EXPO_PUBLIC_SKIP_AUTH=0  → login ON (required for cloud save + DailyDose grades)
EXPO_PUBLIC_SKIP_AUTH=0

EXPO_PUBLIC_SUPABASE_URL=https://bytsiknhtcnlxwzgqkrd.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Google Cloud → Credentials → OAuth 2.0 Client IDs → Web application
# (Client ID ≠ ID token. ID token comes from GoogleSignin.signIn().)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=167530443868-kniil90rorooo9i3vu80sqmtlo3sqqi2.apps.googleusercontent.com

# Optional deep-link override (native builds default to edubite://auth/callback).
# Expo Go uses Linking.createURL('auth/callback') — add that exact URL in Supabase
# Authentication → URL Configuration → Redirect URLs when testing in Expo Go.
# EXPO_PUBLIC_OAUTH_REDIRECT_URL=edubite://auth/callback

# --- Dashboard checklist ---
# 1) Google Cloud → Web client ID = EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID
#    Keep Web Authorized redirect URI:
#      https://bytsiknhtcnlxwzgqkrd.supabase.co/auth/v1/callback
# 2) Android OAuth client: package com.edubite.app + SHA-1 (for native builds)
# 3) Supabase → Auth → Google:
#    - Authorized Client IDs: <WEB_CLIENT_ID>,<ANDROID_CLIENT_ID>
#    - Client secret: Web secret only
#    - Enable "Skip nonce check" (native ID-token path)
# 4) Supabase → Auth → URL Configuration → Redirect URLs include:
#      edubite://auth/callback
#      exp://127.0.0.1:8081/--/auth/callback
#      (and your LAN exp://… URL from Metro logs when using Expo Go)
# 5) Prefer a native build for production-like login:
#      cd apps/mobile && npx eas build --profile development --platform android
